   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 17. Merge the two engines and save the final text\n",
    "# ============================================================\n",
    "import json\n",
    "import os\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "if FINAL_PICK not in {\"best_score\", \"tesseract\", \"paddle\"}:\n",
    "    raise ValueError(f\"FINAL_PICK must be best_score/tesseract/paddle, \"\n",
    "                     f\"got {FINAL_PICK!r}\")\n",
    "\n",
    "\n",
    "def choose(paddle_text, paddle_score, tess_text, tess_score):\n",
    "    \"\"\"Return (text, score, source) for one crop.\n",
    "\n",
    "    An engine that produced nothing can never win, whatever FINAL_PICK says --\n",
    "    empty text is never the better reading.\n",
    "    \"\"\"\n",
    "    has_paddle = bool(paddle_text.strip())\n",
    "    has_tess = bool(tess_text.strip())\n",
    "\n",
    "    if not has_tess:\n",
    "        return paddle_text, paddle_score, \"paddle\"\n",
    "    if not has_paddle:\n",
    "        return tess_text, tess_score, \"tesseract\"\n",
    "\n",
    "    if FINAL_PICK == \"tesseract\":\n",
    "        return tess_text, tess_score, \"tesseract\"\n",
    "    if FINAL_PICK == \"paddle\":\n",
    "        return paddle_text, paddle_score, \"paddle\"\n",
    "\n",
    "    # best_score\n",
    "    p = -1.0 if paddle_score is None else paddle_score\n",
    "    t = -1.0 if tess_score is None else tess_score\n",
    "    if t > p:\n",
    "        return tess_text, tess_score, \"tesseract\"\n",
    "    return paddle_text, paddle_score, \"paddle\"\n",
    "\n",
    "\n",
    "final_rows = []\n",
    "\n",
    "for row in ocr_rows:\n",
    "    tess = tess_result.get(row[\"crop_id\"])\n",
    "    retried = row[\"crop_id\"] in tess_result\n",
    "\n",
    "    tess_text = tess[\"text\"] if tess else \"\"\n",
    "    tess_score = tess[\"mean_rec_score\"] if tess else None\n",
    "    tess_lines = tess[\"n_lines\"] if tess else 0\n",
    "\n",
    "    text, score, source = choose(row[\"text\"], row[\"mean_rec_score\"],\n",
    "                                 tess_text, tess_score)\n",
    "\n",
    "    final_rows.append({\n",
    "        \"crop_id\": row[\"crop_id\"],\n",
    "        \"page\": row[\"page\"],\n",
    "        \"page_number\": row[\"page_number\"],\n",
    "        \"order\": row[\"order\"],\n",
    "        \"label\": row[\"label\"],\n",
    "        \"layout_score\": row[\"layout_score\"],\n",
    "        \"x1\": row[\"x1\"], \"y1\": row[\"y1\"], \"x2\": row[\"x2\"], \"y2\": row[\"y2\"],\n",
    "        \"width\": row[\"width\"], \"height\": row[\"height\"],\n",
    "\n",
    "        \"retried\": retried,\n",
    "        \"paddle_text\": row[\"text\"],\n",
    "        \"paddle_score\": row[\"mean_rec_score\"],\n",
    "        \"paddle_n_lines\": row[\"n_lines\"],\n",
    "        \"tess_text\": tess_text,\n",
    "        \"tess_score\": tess_score,\n",
    "        \"tess_n_lines\": tess_lines,\n",
    "\n",
    "        \"final_source\": source,\n",
    "        \"final_score\": score,\n",
    "        \"text\": text,\n",
    "        \"n_lines\": len(text.split(\"\\n\")) if text.strip() else 0,\n",
    "        \"crop_path\": row[\"crop_path\"],\n",
    "    })\n",
    "\n",
    "final_df = pd.DataFrame(final_rows)\n",
    "\n",
    "# --- save ----------------------------------------------------------------\n",
    "FINAL_TEXT_DIR = os.path.join(OUTPUT_DIR, \"final_text\")\n",
    "os.makedirs(FINAL_TEXT_DIR, exist_ok=True)\n",
    "\n",
    "combined = []\n",
    "for page_name in sorted({r[\"page\"] for r in final_rows}):\n",
    "    page_rows = sorted((r for r in final_rows if r[\"page\"] == page_name),\n",
    "                       key=lambda r: r[\"order\"])\n",
    "    body = \"\\n\\n\".join(f\"[{r['label']} · {r['final_source']}]\\n{r['text']}\"\n",
    "                       for r in page_rows if r[\"text\"].strip())\n",
    "    with open(os.path.join(FINAL_TEXT_DIR, f\"{page_name}.txt\"), \"w\",\n",
    "              encoding=\"utf-8\") as fh:\n",
    "        fh.write(body)\n",
    "    combined.append(f\"===== {page_name} =====\\n{body}\")\n",
    "\n",
    "with open(os.path.join(OUTPUT_DIR, \"final_all_text.txt\"), \"w\",\n",
    "          encoding=\"utf-8\") as fh:\n",
    "    fh.write(\"\\n\\n\".join(combined))\n",
    "\n",
    "final_df.to_csv(os.path.join(OUTPUT_DIR, \"final_boxes.csv\"), index=False,\n",
    "                encoding=\"utf-8-sig\")\n",
    "with open(os.path.join(OUTPUT_DIR, \"final_results.json\"), \"w\",\n",
    "          encoding=\"utf-8\") as fh:\n",
    "    json.dump(final_rows, fh, ensure_ascii=False, indent=1)\n",
    "\n",
    "# --- summary -------------------------------------------------------------\n",
    "retried_df = final_df[final_df[\"retried\"]]\n",
    "won = int((retried_df[\"final_source\"] == \"tesseract\").sum())\n",
    "rescued = int(((retried_df[\"paddle_n_lines\"] == 0)\n",
    "               & (retried_df[\"tess_n_lines\"] > 0)).sum())\n",
    "\n",
    "print(f\"FINAL_PICK = {FINAL_PICK}\\n\")\n",
    "print(f\"crops total            : {len(final_df)}\")\n",
    "print(f\"retried with Tesseract : {len(retried_df)}\")\n",
    "print(f\"  Tesseract chosen     : {won}\")\n",
    "print(f\"  PaddleOCR kept       : {len(retried_df) - won}\")\n",
    "print(f\"  rescued from empty   : {rescued}  (Paddle read nothing, Tesseract did)\")\n",
    "print(f\"\\nlines before : {int(final_df['paddle_n_lines'].sum())}\")\n",
    "print(f\"lines after  : {int(final_df['n_lines'].sum())}\")\n",
    "print(f\"crops with text: {int((final_df['n_lines'] > 0).sum())} / {len(final_df)}\")\n",
    "\n",
    "if len(retried_df):\n",
    "    print(\"\\n=== retried crops, by label ===\")\n",
    "    display(\n",
    "        retried_df.groupby(\"label\").agg(\n",
    "            crops=(\"crop_id\", \"count\"),\n",
    "            paddle_score=(\"paddle_score\", \"mean\"),\n",
    "            tess_score=(\"tess_score\", \"mean\"),\n",
    "            tess_won=(\"final_source\", lambda s: (s == \"tesseract\").sum()),\n",
    "        ).round(3).sort_values(\"crops\", ascending=False)\n",
    "    )\n",
    "\n",
    "print(\"\\n\" + \"!\" * 72)\n",
    "print(\"CAVEAT on FINAL_PICK='best_score': the two engines do NOT compute\")\n",
    "print(\"confidence the same way. PP-OCRv5 scores a recognized line; Tesseract\")\n",
    "print(\"averages per-word confidences. A higher number does not reliably mean\")\n",
    "print(\"a better reading. Use cell 18 to eyeball the retried crops, and switch\")\n",
    "print(\"FINAL_PICK to 'paddle' (fill gaps only) if the picks look wrong.\")\n",
    "print(\"!\" * 72)\n",
    "\n",
    "print(f\"\\nSaved -> {os.path.abspath(OUTPUT_DIR)}\")\n",
    "print(\"  final_boxes.csv        both readings + which one won, per crop\")\n",
    "print(\"  final_results.json     same as JSON\")\n",
    "print(\"  final_all_text.txt     merged text, every page\")\n",
    "print(\"  final_text/page_XXXX.txt  one file per page\")"
   ]
  },
