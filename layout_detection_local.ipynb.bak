   "source": [
    "# ============================================================\n",
    "# 16. Re-OCR the low-confidence crops with Tesseract\n",
    "# ============================================================\n",
    "import json\n",
    "import os\n",
    "import socket\n",
    "import time\n",
    "from urllib.parse import urlparse\n",
    "\n",
    "import requests\n",
    "\n",
    "# --- which crops need a second opinion -----------------------------------\n",
    "def needs_retry(row):\n",
    "    \"\"\"Empty results always retry; otherwise go by PaddleOCR's mean score.\"\"\"\n",
    "    if row[\"n_lines\"] == 0:\n",
    "        return True\n",
    "    score = row[\"mean_rec_score\"]\n",
    "    return score is None or score < RETRY_BELOW\n",
    "\n",
    "\n",
    "retry_rows = [r for r in ocr_rows if needs_retry(r)]\n",
    "\n",
    "print(f\"{len(retry_rows)} of {len(ocr_rows)} crop(s) below \"\n",
    "      f\"RETRY_BELOW={RETRY_BELOW} (or empty)\")\n",
    "\n",
    "if not retry_rows:\n",
    "    print(\"Nothing to retry -- PaddleOCR was confident everywhere.\")\n",
    "    tess_raw, tess_failures = {}, []\n",
    "else:\n",
    "    # --- connect ---------------------------------------------------------\n",
    "    TESS_BASE_URL = TESS_BASE_URL.strip().rstrip(\"/\")\n",
    "    if not TESS_BASE_URL.startswith((\"http://\", \"https://\")):\n",
    "        TESS_BASE_URL = \"https://\" + TESS_BASE_URL\n",
    "\n",
    "    TESS_HEADERS = {\"Authorization\": f\"Bearer {TESS_TOKEN.strip()}\"}\n",
    "    tess_host = urlparse(TESS_BASE_URL).hostname\n",
    "\n",
    "    try:\n",
    "        socket.getaddrinfo(tess_host, 443)\n",
    "    except socket.gaierror:\n",
    "        raise ConnectionError(\n",
    "            f\"'{tess_host}' does not resolve -- the Tesseract tunnel is dead.\\n\"\n",
    "            \"Re-run the token / uvicorn / cloudflared cells in the Tesseract \"\n",
    "            \"Colab notebook, then paste the new TESS_BASE_URL and TESS_TOKEN.\"\n",
    "        ) from None\n",
    "\n",
    "    health = requests.get(f\"{TESS_BASE_URL}/health\", headers=TESS_HEADERS,\n",
    "                          timeout=60)\n",
    "    if health.status_code == 401:\n",
    "        raise PermissionError(\"401 -- TESS_TOKEN does not match that server.\")\n",
    "    health.raise_for_status()\n",
    "    info = health.json()\n",
    "\n",
    "    print(f\"\\nTesseract server: {TESS_BASE_URL}\")\n",
    "    print(f\"  engine  : {info.get('engine')} {info.get('tesseract_version')}\")\n",
    "    print(f\"  config  : {info.get('config')}\")\n",
    "\n",
    "    if info.get(\"engine\") != \"tesseract\":\n",
    "        raise ValueError(\n",
    "            f\"That url is not the Tesseract server (engine=\"\n",
    "            f\"{info.get('engine')!r}). You may have pasted the PaddleOCR url.\"\n",
    "        )\n",
    "\n",
    "    # --- send ------------------------------------------------------------\n",
    "    TESS_RAW_DIR = os.path.join(OUTPUT_DIR, \"ocr_raw_tesseract\")\n",
    "    os.makedirs(TESS_RAW_DIR, exist_ok=True)\n",
    "\n",
    "    # Separate directory from ocr_raw/ on purpose: sharing it would let\n",
    "    # OCR_RESUME hand back the cached PaddleOCR answer instead of calling\n",
    "    # Tesseract at all.\n",
    "\n",
    "    extra = {}\n",
    "    if TESS_PSM is not None:\n",
    "        extra[\"psm\"] = TESS_PSM\n",
    "    if TESS_LANG is not None:\n",
    "        extra[\"lang\"] = TESS_LANG\n",
    "    if TESS_SCALE is not None:\n",
    "        extra[\"scale\"] = TESS_SCALE\n",
    "\n",
    "    def tess_one(row):\n",
    "        last_error = None\n",
    "        for attempt in range(1, OCR_RETRIES + 1):\n",
    "            try:\n",
    "                with open(row[\"crop_path\"], \"rb\") as fh:\n",
    "                    response = requests.post(\n",
    "                        f\"{TESS_BASE_URL}/infer\",\n",
    "                        headers=TESS_HEADERS,\n",
    "                        data={\"page\": row[\"page_number\"], **extra},\n",
    "                        files={\"file\": (os.path.basename(row[\"crop_path\"]), fh,\n",
    "                                        \"image/png\")},\n",
    "                        timeout=OCR_TIMEOUT,\n",
    "                    )\n",
    "                if response.status_code == 200:\n",
    "                    return response.json(), None\n",
    "                last_error = f\"HTTP {response.status_code}: {response.text[:300]}\"\n",
    "            except Exception as exc:\n",
    "                last_error = repr(exc)\n",
    "\n",
    "            if attempt < OCR_RETRIES:\n",
    "                time.sleep(2 * attempt)\n",
    "\n",
    "        return None, last_error\n",
    "\n",
    "    tess_raw = {}\n",
    "    tess_failures = []\n",
    "\n",
    "    print(f\"\\nSending {len(retry_rows)} crop(s) to Tesseract ...\\n\")\n",
    "    started = time.perf_counter()\n",
    "\n",
    "    for i, row in enumerate(retry_rows, start=1):\n",
    "        crop_id = row[\"crop_id\"]\n",
    "        raw_path = os.path.join(TESS_RAW_DIR, crop_id + \".json\")\n",
    "\n",
    "        if OCR_RESUME and os.path.exists(raw_path):\n",
    "            with open(raw_path, encoding=\"utf-8\") as fh:\n",
    "                tess_raw[crop_id] = json.load(fh)\n",
    "            print(f\"[{i}/{len(retry_rows)}] {crop_id}  (cached)\")\n",
    "            continue\n",
    "\n",
    "        payload, error = tess_one(row)\n",
    "\n",
    "        if payload is None:\n",
    "            tess_failures.append({\"crop_id\": crop_id, \"error\": error})\n",
    "            print(f\"[{i}/{len(retry_rows)}] {crop_id}  FAILED: {error}\")\n",
    "            continue\n",
    "\n",
    "        with open(raw_path, \"w\", encoding=\"utf-8\") as fh:\n",
    "            json.dump(payload, fh, ensure_ascii=False)\n",
    "        tess_raw[crop_id] = payload\n",
    "\n",
    "        rate = (time.perf_counter() - started) / i\n",
    "        print(f\"[{i}/{len(retry_rows)}] {crop_id}  \"\n",
    "              f\"({rate:.1f}s/crop, eta {rate * (len(retry_rows) - i) / 60:.1f} min)\")\n",
    "\n",
    "    print(f\"\\nDone in {(time.perf_counter() - started) / 60:.1f} min\")\n",
    "    print(f\"  succeeded : {len(tess_raw)}\")\n",
    "    print(f\"  failed    : {len(tess_failures)}\")\n",
    "    print(f\"  raw JSON  : {os.path.abspath(TESS_RAW_DIR)}\")\n",
    "\n",
    "    if tess_failures:\n",
    "        print(\"\\nFailures (re-run this cell to retry -- successes are cached):\")\n",
    "        for f in tess_failures[:10]:\n",
    "            print(f\"  {f['crop_id']}: {f['error']}\")\n",
    "\n",
    "# --- pull the text out of the Tesseract responses ------------------------\n",
    "# The Tesseract server deliberately reuses PaddleOCR's rec_texts/rec_scores\n",
    "# field names, so the same extractor works on both.\n",
    "tess_result = {}\n",
    "\n",
    "for crop_id, payload in tess_raw.items():\n",
    "    texts, scores = [], []\n",
    "    for block_texts, block_scores in iter_rec_blocks(payload.get(\"raw\")):\n",
    "        texts.extend(block_texts)\n",
    "        scores.extend(block_scores)\n",
    "\n",
    "    tess_result[crop_id] = {\n",
    "        \"text\": \"\\n\".join(texts),\n",
    "        \"n_lines\": len(texts),\n",
    "        \"mean_rec_score\": round(sum(scores) / len(scores), 4) if scores else None,\n",
    "    }\n",
    "\n",
    "got_text = sum(1 for v in tess_result.values() if v[\"text\"])\n",
    "print(f\"\\nTesseract returned text for {got_text}/{len(retry_rows)} retried crop(s)\")"
   ]
  },
