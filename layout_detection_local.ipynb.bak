   "source": [
    "# ============================================================\n",
    "# 18. Side by side: what each engine read on the retried crops\n",
    "# ============================================================\n",
    "import html\n",
    "\n",
    "from IPython.display import HTML, display\n",
    "\n",
    "# None = every retried crop, or cap it: SHOW_N = 10\n",
    "SHOW_N = None\n",
    "\n",
    "rows = [r for r in final_rows if r[\"tess_text\"] or r[\"paddle_text\"]]\n",
    "rows = [r for r in rows if r[\"crop_id\"] in tess_result]\n",
    "if SHOW_N:\n",
    "    rows = rows[:SHOW_N]\n",
    "\n",
    "if not rows:\n",
    "    print(\"Nothing was retried, so there is nothing to compare.\")\n",
    "\n",
    "CSS = \"\"\"\n",
    "<style>\n",
    ".cmp      { border: 1px solid #8884; border-radius: 8px; margin: 14px 0;\n",
    "            padding: 10px 14px; }\n",
    ".cmphead  { font-family: ui-monospace, SFMono-Regular, monospace;\n",
    "            font-size: .82rem; opacity: .7; border-bottom: 1px solid #8883;\n",
    "            padding-bottom: 6px; margin-bottom: 10px; }\n",
    ".cmpgrid  { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\n",
    "@media (max-width: 820px) { .cmpgrid { grid-template-columns: 1fr; } }\n",
    ".cmpcol   { border: 1px solid #8883; border-radius: 6px; padding: 8px 12px; }\n",
    ".cmpwin   { border-color: #4c9a4c; }\n",
    ".cmptag   { font-family: ui-monospace, SFMono-Regular, monospace;\n",
    "            font-size: .72rem; opacity: .7; margin-bottom: 6px; }\n",
    ".cmptxt   { direction: rtl; text-align: right; line-height: 1.85;\n",
    "            font-family: \"Segoe UI\", Tahoma, sans-serif; font-size: 1rem; }\n",
    ".cmpnone  { opacity: .45; font-style: italic; direction: ltr;\n",
    "            text-align: left; }\n",
    ".cmpimg   { max-width: 100%; margin-bottom: 10px; }\n",
    "</style>\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def column(tag, text, score, n_lines, is_winner):\n",
    "    score_txt = \"--\" if score is None else f\"{score:.3f}\"\n",
    "    body = (f'<div class=\"cmptxt\">{html.escape(text).replace(chr(10), \"<br>\")}</div>'\n",
    "            if text.strip() else '<div class=\"cmpnone\">no text</div>')\n",
    "    return (f'<div class=\"cmpcol{\" cmpwin\" if is_winner else \"\"}\">'\n",
    "            f'<div class=\"cmptag\">{tag} &nbsp;|&nbsp; score {score_txt} '\n",
    "            f'&nbsp;|&nbsp; {n_lines} line(s)'\n",
    "            f'{\" &nbsp;| CHOSEN\" if is_winner else \"\"}</div>{body}</div>')\n",
    "\n",
    "\n",
    "parts = [CSS]\n",
    "\n",
    "for row in rows:\n",
    "    # Inline the crop as a data URI so the HTML block stays self-contained.\n",
    "    import base64\n",
    "\n",
    "    with open(row[\"crop_path\"], \"rb\") as fh:\n",
    "        b64 = base64.b64encode(fh.read()).decode()\n",
    "\n",
    "    parts.append(\n",
    "        f'<div class=\"cmp\">'\n",
    "        f'<div class=\"cmphead\">{html.escape(row[\"crop_id\"])} '\n",
    "        f'&nbsp;|&nbsp; layout {html.escape(row[\"label\"])} '\n",
    "        f'{row[\"layout_score\"]:.2f} &nbsp;|&nbsp; '\n",
    "        f'chosen: <b>{row[\"final_source\"]}</b></div>'\n",
    "        f'<img class=\"cmpimg\" src=\"data:image/png;base64,{b64}\">'\n",
    "        f'<div class=\"cmpgrid\">'\n",
    "        + column(\"PaddleOCR\", row[\"paddle_text\"], row[\"paddle_score\"],\n",
    "                 row[\"paddle_n_lines\"], row[\"final_source\"] == \"paddle\")\n",
    "        + column(\"Tesseract\", row[\"tess_text\"], row[\"tess_score\"],\n",
    "                 row[\"tess_n_lines\"], row[\"final_source\"] == \"tesseract\")\n",
    "        + '</div></div>'\n",
    "    )\n",
    "\n",
    "display(HTML(\"\".join(parts)))\n",
    "print(f\"{len(rows)} retried crop(s) shown. Green border = the reading that \"\n",
    "      f\"went into the final text.\")"
   ]
  },
